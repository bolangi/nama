# ecasound chainsetup file

# general

-z:mixmode,sum -G:jack,Nama,send -G:jack,NamaEcasound, -b 256 -z:db,100000 -z:nointbuf

# audio inputs

-a:3 -i:alsa,default
-a:4,5,6,7 -i:loop,pre1_out
-a:8,9 -i:loop,pre2_out

# post-input processing

-a:3
-a:5 -chorder:1,3
-a:6 -chorder:3
-a:7 -chorder:4,5

# pre-output processing

-a:6  -chorder:0,0,0,0,0,0,1
-a:7  -chorder:0,0,0,0,0,0,0,0,1,2
-a:8  -chorder:0,0,1,2
-a:9  -chorder:0,0,0,0,1,2

# audio outputs

-a:3 -o:loop,pre1_out
-a:4 -o:loop,pre2_out
-a:5,6,7,8,9 -o:alsa,default
